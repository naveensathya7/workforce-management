<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<!-- ==================== 1.0: departments ==================== -->
	<changeSet id="1.0-create-departments" author="naveen">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="departments" />
			</not>
		</preConditions>
		<createTable tableName="departments">
			<column name="dep_id" type="bigint" autoIncrement="true">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="name" type="varchar(255)">
				<constraints nullable="false" />
			</column>
			<column name="description" type="text" />
		</createTable>
	</changeSet>

	<!-- ==================== 1.1: employees ==================== -->
	<changeSet id="1.1-create-employees" author="naveen">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="employees" />
			</not>
		</preConditions>
		<createTable tableName="employees">
			<column name="employee_id" type="bigint" autoIncrement="true">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="employee_code" type="varchar(255)">
				<constraints unique="true" />
			</column>
			<column name="first_name" type="varchar(255)" />
			<column name="last_name" type="varchar(255)" />
			<column name="email" type="varchar(255)" />
			<column name="phone_number" type="varchar(255)" />
			<column name="designation" type="varchar(255)" />
			<column name="department_id" type="bigint" />
		</createTable>
		<addForeignKeyConstraint
			constraintName="fk_employee_department" baseTableName="employees"
			baseColumnNames="department_id" referencedTableName="departments"
			referencedColumnNames="dep_id" onDelete="SET NULL" />
	</changeSet>

	<!-- ==================== 1.2: projects ==================== -->
	<changeSet id="1.2-create-projects" author="naveen">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="projects" />
			</not>
		</preConditions>
		<createTable tableName="projects">
			<column name="project_id" type="bigint" autoIncrement="true">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="name" type="varchar(255)" />
			<column name="description" type="text" />
			<column name="start_date" type="date" />
			<column name="end_date" type="date" />
			<column name="status" type="varchar(50)">
				<constraints nullable="false" />
			</column>
			<column name="created_at" type="timestamp" />
			<column name="updated_at" type="timestamp" />
		</createTable>
	</changeSet>

	<!-- ==================== 1.3: tasks ==================== -->
	<changeSet id="1.3-create-tasks" author="naveen">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="tasks" />
			</not>
		</preConditions>
		<createTable tableName="tasks">
			<column name="task_id" type="bigint" autoIncrement="true">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="title" type="varchar(255)" />
			<column name="description" type="text" />
			<column name="status" type="varchar(50)">
				<constraints nullable="false" />
			</column>
			<column name="priority" type="varchar(50)">
				<constraints nullable="false" />
			</column>
			<column name="due_date" type="date" />
			<column name="employee_id" type="bigint" />
			<column name="project_id" type="bigint" />
			<column name="created_at" type="timestamp" />
			<column name="updated_at" type="timestamp" />
		</createTable>
		<addForeignKeyConstraint
			constraintName="fk_task_employee" baseTableName="tasks"
			baseColumnNames="employee_id" referencedTableName="employees"
			referencedColumnNames="employee_id" onDelete="SET NULL" />
		<addForeignKeyConstraint
			constraintName="fk_task_project" baseTableName="tasks"
			baseColumnNames="project_id" referencedTableName="projects"
			referencedColumnNames="project_id" onDelete="CASCADE" />
	</changeSet>
	<changeSet id="1.4-create-audit-logs" author="naveen">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="audit_logs" />
			</not>
		</preConditions>
		<createTable tableName="audit_logs">
			<column name="id" type="bigint" autoIncrement="true">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="action" type="varchar(255)">
				<constraints nullable="false" />
			</column>
			<column name="details" type="text" />
			<column name="performed_by" type="varchar(255)" />
			<column name="timestamp" type="timestamp">
				<constraints nullable="false" />
			</column>
			<column name="execution_time_ms" type="bigint" />
		</createTable>
	</changeSet>
	<!-- ==================== 1.5: users ==================== -->
	<changeSet id="1.5-create-users" author="naveen">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="users" />
			</not>
		</preConditions>
		<createTable tableName="users">
			<column name="user_id" type="bigint" autoIncrement="true">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="username" type="varchar(255)">
				<constraints nullable="false" unique="true" />
			</column>
			<column name="password" type="varchar(255)">
				<constraints nullable="false" />
			</column>
			<column name="role" type="varchar(50)">
				<constraints nullable="false" />
			</column>
			<column name="employee_id" type="bigint">
				<constraints unique="true" />
			</column>
			<column name="is_enabled" type="boolean"
				defaultValueBoolean="true">
				<constraints nullable="false" />
			</column>
			<column name="is_credentials_non_expired" type="boolean"
				defaultValueBoolean="true">
				<constraints nullable="false" />
			</column>
			<column name="is_account_non_locked" type="boolean"
				defaultValueBoolean="true">
				<constraints nullable="false" />
			</column>
			<column name="is_account_non_expired" type="boolean"
				defaultValueBoolean="true">
				<constraints nullable="false" />
			</column>
		</createTable>

		<!-- Link users to employees (One-to-One FK) -->
		<addForeignKeyConstraint
			constraintName="fk_user_employee" baseTableName="users"
			baseColumnNames="employee_id" referencedTableName="employees"
			referencedColumnNames="employee_id" onDelete="CASCADE" />
	</changeSet>
	<changeSet id="1.6-create-roles-table" author="naveen">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="roles" />
			</not>
		</preConditions>
		<createTable tableName="roles">
			<column name="role_id" type="bigint" autoIncrement="true">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="name" type="varchar(50)">
				<constraints nullable="false" unique="true" />
			</column>
			<column name="description" type="text" />
		</createTable>
	</changeSet>

	<changeSet id="1.6-insert-roles" author="naveen">
		<preConditions onFail="MARK_RAN">
			<tableExists tableName="roles" />
		</preConditions>
		<loadData tableName="roles" file="data/roles.csv"
			relativeToChangelogFile="false" separator="," encoding="UTF-8">
			<column name="role_id" header="id" type="NUMERIC" />
			<column name="name" header="name" type="STRING" />
			<column name="description" header="description" type="STRING" />
		</loadData>
	</changeSet>

	<changeSet id="1.7-create-role-method-permissions"
		author="naveen">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="role_method_permissions" />
			</not>
		</preConditions>
		<createTable tableName="role_method_permissions">
			<column name="id" type="bigint" autoIncrement="true">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="role_id" type="bigint">
				<constraints nullable="false" />
			</column>
			<column name="controller" type="varchar(255)">
				<constraints nullable="false" />
			</column>
			<column name="methods" type="text">
				<constraints nullable="false" />
			</column>
		</createTable>

		<addForeignKeyConstraint
			constraintName="fk_permission_role"
			baseTableName="role_method_permissions" baseColumnNames="role_id"
			referencedTableName="roles" referencedColumnNames="role_id"
			onDelete="CASCADE" />
	</changeSet>

	<changeSet id="1.8-update-users-role-fk" author="naveen">
		<validCheckSum>9:5d5902dff3543c3fd7758e2d97d1c8d1</validCheckSum>

		<!-- Add role_id column to users -->
		<addColumn tableName="users">
			<column name="role_id" type="bigint" />
		</addColumn>

		<!-- Migrate existing data: map string 'role' to 'roles.role_id' -->
		<!-- PostgreSQL specific syntax -->
		<sqlFile dbms="postgresql"
			path="sql/1.8-migrate-roles.postgres.sql"
			relativeToChangelogFile="true" />

		<!-- MySQL specific syntax -->
		<sqlFile dbms="mysql" path="sql/1.8-migrate-roles.mysql.sql"
			relativeToChangelogFile="true" />

		<!-- Drop old role column -->
		<dropColumn tableName="users" columnName="role" />

		<!-- Add foreign key constraint to roles -->
		<addForeignKeyConstraint
			constraintName="fk_user_role" baseTableName="users"
			baseColumnNames="role_id" referencedTableName="roles"
			referencedColumnNames="role_id" onDelete="RESTRICT" />
	</changeSet>

	<!-- PostgreSQL specific trigger -->
	<changeSet id="1.9-add-users-audit-trigger" author="naveen"
		dbms="postgresql">
		<sqlFile path="sql/1.9-audit-trigger.postgres.sql"
			relativeToChangelogFile="true" splitStatements="false" />
	</changeSet>

	<!-- MySQL specific trigger -->
	<changeSet id="1.9-add-users-audit-trigger-mysql"
		author="naveen" dbms="mysql">
		<sqlFile path="sql/1.9-audit-trigger.mysql.sql"
			relativeToChangelogFile="true" splitStatements="false" />
	</changeSet>

	<!-- Required before 1.10 so its ON CONFLICT upsert has a constraint to
		match against -->
	<changeSet id="1.10.0-add-unique-role-controller-constraint"
		author="naveen">
		<preConditions onFail="MARK_RAN">
			<not>
				<indexExists indexName="uq_role_controller" />
			</not>
		</preConditions>
		<addUniqueConstraint
			constraintName="uq_role_controller"
			tableName="role_method_permissions" columnNames="role_id,controller" />
	</changeSet>

	<changeSet id="1.10-seed-role-permissions" author="naveen"
		runOnChange="true">

		<!-- Recreate temp table each run so a re-run (triggered by an edited CSV)
			starts clean -->
		<sql>DROP TABLE IF EXISTS temp_permissions;</sql>

		<createTable tableName="temp_permissions">
			<column name="role_name" type="varchar(50)" />
			<column name="controller" type="varchar(255)" />
			<column name="methods" type="text" />
		</createTable>

		<!-- Load CSV data into the temporary table -->
		<loadData tableName="temp_permissions"
			file="data/controller-permissions.csv"
			relativeToChangelogFile="false" separator="," encoding="UTF-8">
			<column name="role_name" header="role" type="STRING" />
			<column name="controller" header="controller" type="STRING" />
			<column name="methods" header="methods" type="STRING" />
		</loadData>

		<!-- Upsert into the actual table by looking up the role_id. ON CONFLICT
			requires the uq_role_controller unique constraint (see 1.10.0) and is what
			makes this changeset safe to re-run via runOnChange when the CSV is edited:
			existing (role_id, controller) rows get their methods updated instead of
			erroring on a duplicate insert. Note this only adds/updates rows present
			in the CSV — a row removed from the CSV is NOT deleted from the table. -->
		<sql>
			INSERT INTO role_method_permissions (role_id, controller,
			methods)
			SELECT r.role_id, t.controller, t.methods
			FROM
			temp_permissions t
			JOIN roles r ON r.name = t.role_name
			ON CONFLICT
			(role_id, controller)
			DO UPDATE SET methods = EXCLUDED.methods;
		</sql>

		<!-- Clean up the temporary table -->
		<dropTable tableName="temp_permissions" />
	</changeSet>

	<changeSet id="1.11-create-refresh-tokens" author="naveen">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="refresh_tokens" />
			</not>
		</preConditions>
		<createTable tableName="refresh_tokens">
			<column name="id" type="bigint" autoIncrement="true">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="token" type="varchar(255)">
				<constraints nullable="false" unique="true" />
			</column>
			<column name="user_id" type="bigint">
				<constraints nullable="false" />
			</column>
			<column name="expiry_date" type="timestamp">
				<constraints nullable="false" />
			</column>
			<column name="revoked" type="boolean">
				<constraints nullable="false" />
			</column>
		</createTable>
		<addForeignKeyConstraint
			constraintName="fk_refresh_token_user" baseTableName="refresh_tokens"
			baseColumnNames="user_id" referencedTableName="users"
			referencedColumnNames="user_id" onDelete="CASCADE" />
	</changeSet>

	<changeSet id="1.12-add-device-id-to-refresh-tokens"
		author="naveen">
		<preConditions onFail="MARK_RAN">
			<not>
				<columnExists tableName="refresh_tokens"
					columnName="device_id" />
			</not>
		</preConditions>
		<addColumn tableName="refresh_tokens">
			<column name="device_id" type="varchar(255)">
				<constraints nullable="false" />
			</column>
		</addColumn>
		<addUniqueConstraint
			constraintName="uq_refresh_token_user_device"
			tableName="refresh_tokens" columnNames="user_id,device_id" />
	</changeSet>

	<changeSet id="1.13-add-token-version-to-users"
		author="naveen">
		<preConditions onFail="MARK_RAN">
			<not>
				<columnExists tableName="users"
					columnName="token_version" />
			</not>
		</preConditions>
		<addColumn tableName="users">
			<column name="token_version" type="int"
				defaultValueNumeric="0">
				<constraints nullable="false" />
			</column>
		</addColumn>
	</changeSet>
	<changeSet
		id="1.15-drop-refresh-token-user-device-constraint" author="naveen"
		runOnChange="true">
		<preConditions onFail="MARK_RAN">
			<indexExists indexName="uq_refresh_token_user_device" />
		</preConditions>
		<dropUniqueConstraint tableName="refresh_tokens"
			constraintName="uq_refresh_token_user_device" />
	</changeSet>
	<changeSet id="1.16-refresh-token-active-partial-index"
		author="naveen">
		<preConditions onFail="MARK_RAN">
			<not>
				<indexExists
					indexName="uq_refresh_token_user_device_active" />
			</not>
		</preConditions>
		<sql>
			CREATE UNIQUE INDEX uq_refresh_token_user_device_active
			ON
			refresh_tokens (user_id, device_id)
			WHERE revoked = false;
		</sql>
	</changeSet>



</databaseChangeLog>
